# Copy to .env and fill in before `docker compose up`.
#   cp .env.example .env
# .env is gitignored. Never commit real values.

# ── required ────────────────────────────────────────────────────────────────
# Flask signs session cookies with this. Compose refuses to start without it,
# on purpose: a default would mean every deployment shares the same key and
# anyone could forge an admin session.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Postgres password, used by the database, the vote service and the worker.
POSTGRES_PASSWORD=

# The first administrator, created at start-up if it does not already exist.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── optional ────────────────────────────────────────────────────────────────
# true once real TLS certificates are in place. Leaving it false over HTTPS
# means the session cookie is sent on plain HTTP too.
SESSION_COOKIE_SECURE=false

# Hours before a login expires. Admin sessions use the same value.
SESSION_HOURS=8

APP_VERSION=dev
LOG_LEVEL=INFO

# Gunicorn. Leave unset to size workers from the available CPUs.
# WEB_CONCURRENCY=4
